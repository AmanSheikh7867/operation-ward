# Operation Ward Zero – Environment Configuration Template
# Copy this file to ward.env or .env and fill in your actual credentials.
# The application gracefully falls back to in-memory buffering and rule-based AI if credentials are absent.

# Supabase Persistence (Optional)
# Use your project URL and secret service_role key (server-side only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=sb_secret_your_service_role_key_here

# Groq AI Caregiver Assistant (Optional)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# MQTT Broker (Default: broker.hivemq.com for demo, or localhost for local Mosquitto)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=wardzero

# System Thresholds
RISK_THRESHOLD=0.6
ALERT_COOLDOWN_S=20
DB_TIMEOUT_S=5
BUFFER_MAX=5000
